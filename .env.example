# Reference values for DBTALK_* process environment variables.
# Reuse existing DBTALK_DSN_* names; add missing connections to .env without changing other entries.
# Never put actual credentials in this example file.
DBTALK_VERBOSE=false
DBTALK_LOGGING__LEVEL=INFO
DBTALK_LOGGING__FORMAT=%(levelname)s %(name)s: %(message)s

DBTALK_MYSQL__OUTPUT_DIRECTORY=data
DBTALK_MYSQL__CLIENT_IMAGE=mysql:8.0.39
DBTALK_MYSQL__ZERO_DATETIME_AS_NULL=true

DBTALK_DATABASE__QUERY_TIMEOUT_SECONDS=30
DBTALK_DATABASE__EXEC_TIMEOUT_SECONDS=30

DBTALK_POSTGRES__OUTPUT_DIRECTORY=data
DBTALK_POSTGRES__CLIENT_IMAGE=postgres:18-alpine
